# Google Drive OAuth（ローカルテスト用。凍結時は未設定でよい）
# このファイルを .env にコピーし、値を記入してください。
# .env は .gitignore によりリポジトリに含まれません。

GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=

# 任意: フォルダIDを上書きする場合のみ
# GDRIVE_FOLDER_ID_WORK=
# GDRIVE_FOLDER_ID_PAID=
# GDRIVE_FOLDER_ID_PUBLIC=

# Cloudflare R2（日次成果物のミラー先。S3互換API）
# R2_ENDPOINT_URL はダッシュボードURLではなく S3 互換エンドポイント（例: https://<ACCOUNT_ID>.r2.cloudflarestorage.com）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
# R2_BASE_PREFIX はバケット直下のプレフィックス（バケット名は含めない）。例: stock-radar-system/
R2_BASE_PREFIX=
R2_ENDPOINT_URL=

# Dropbox（日次成果物のミラー先。App Folder の refresh token）
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# DROPBOX_BASE_FOLDER は /Apps/stock-radar-system のような Apps ルート（URL ではなくパス推奨）
DROPBOX_BASE_FOLDER=
