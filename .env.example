# Google Drive OAuth（ローカルテスト用。凍結時は未設定でよい）
# このファイルを .env にコピーし、値を記入してください。
# .env は .gitignore によりリポジトリに含まれません。

GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=

# 任意: フォルダIDを上書きする場合のみ
# GDRIVE_FOLDER_ID_WORK=
# GDRIVE_FOLDER_ID_PAID=
# GDRIVE_FOLDER_ID_PUBLIC=

# Cloudflare R2（日次成果物のミラー先。S3互換API）
# R2_ENDPOINT_URL はダッシュボードURLではなく S3 互換エンドポイント（例: https://<ACCOUNT_ID>.r2.cloudflarestorage.com）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
# R2_BASE_PREFIX はバケット直下のプレフィックス（バケット名は含めない）。通常は空でOK（例: "" や "prod/"）
R2_BASE_PREFIX=
R2_ENDPOINT_URL=

# Dropbox（日次成果物のミラー先。App Folder の refresh token）
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# DROPBOX_BASE_FOLDER は App folder の場合は通常空でOK（アプリフォルダ直下がルートになる）。URL や /Apps/stock-radar-system は入れない。
DROPBOX_BASE_FOLDER=
# 429/5xx時の再試行パラメータ（任意）
# DROPBOX_UPLOAD_RETRY_MAX=8
# DROPBOX_UPLOAD_BACKOFF_BASE_SEC=1
# DROPBOX_UPLOAD_BACKOFF_CAP_SEC=30
