# Google Drive OAuth（ローカルテスト用。凍結時は未設定でよい）
# このファイルを .env にコピーし、値を記入してください。
# .env は .gitignore によりリポジトリに含まれません。

GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=

# 任意: フォルダIDを上書きする場合のみ
# GDRIVE_FOLDER_ID_WORK=
# GDRIVE_FOLDER_ID_PAID=
# GDRIVE_FOLDER_ID_PUBLIC=


CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Phase 1: Cloudflare Worker → GitHub workflow_dispatch (daily.yml)
# GH_DISPATCH_TOKEN は Worker secret として wrangler secret put で設定（ローカル smoke 用にここでも可）
# GH_DISPATCH_TOKEN=
# GITHUB_OWNER=kuwatajunichi-cyber
# GITHUB_REPO=stockradarsystem
# GITHUB_REF=main
# LIVE_DISPATCH_ENABLED=true  # 手動 smoke で実 dispatch する場合のみ

# Cloudflare R2（日次成果物のミラー先。S3互換API）
# R2_ENDPOINT_URL はダッシュボードURLではなく S3 互換エンドポイント（例: https://<ACCOUNT_ID>.r2.cloudflarestorage.com）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
# R2_BASE_PREFIX はバケット直下のプレフィックス（バケット名は含めない）。通常は空でOK（例: "" や "prod/"）
R2_BASE_PREFIX=
R2_ENDPOINT_URL=

# Supabase（Phase 3 control plane — backend 書込専用）
# workflow から参照するのは SUPABASE_URL + SUPABASE_SECRET_KEY の 2 変数のみ。
# SERVICE_ROLE_KEY / ANON_KEY / PUBLISHABLE_KEY は Legacy 参考（workflow 非使用）。
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STOCK_RADAR_SYSTEM_PASSWORD=

# Dropbox（日次成果物のミラー先。App Folder の refresh token）
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# DROPBOX_BASE_FOLDER は App folder の場合は通常空でOK（アプリフォルダ直下がルートになる）。URL や /Apps/stock-radar-system は入れない。
DROPBOX_BASE_FOLDER=
# 429/5xx時の再試行パラメータ（任意）
# DROPBOX_UPLOAD_RETRY_MAX=8
# DROPBOX_UPLOAD_BACKOFF_BASE_SEC=1
# DROPBOX_UPLOAD_BACKOFF_CAP_SEC=30

# 日次 ensure_*（--run-date 指定時）: stale のみ待機リトライ
# STALE_RETRY_MAX_PASSES=3
# STALE_RETRY_SLEEP_SEC=300